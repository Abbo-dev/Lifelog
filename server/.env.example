## Server environment variables (Paddle webhook + Firestore updates)

# Server
PORT=4242
APP_URL=http://localhost:5173
# Production example:
# APP_URL=https://your-app.web.app
# Optional: allow a second origin (e.g., localhost + production)
APP_URL_LOCAL=http://localhost:5173

# Paddle (Billing)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_MONTHLY=
PADDLE_PRICE_ID_ANNUAL=

# Optional: override Paddle API base URL
PADDLE_API_BASE_URL=https://api.paddle.com

# Paddle API request resilience
PADDLE_REQUEST_TIMEOUT_MS=10000
PADDLE_REQUEST_RETRIES=1
PADDLE_REQUEST_RETRY_DELAY_MS=300

# Paddle webhook idempotency cleanup (Firestore TTL requires console setup)
PADDLE_EVENT_TTL_DAYS=30

# Rate limiting (in-memory, per instance)
CHECKOUT_RATE_WINDOW_MS=300000
CHECKOUT_RATE_MAX=15
PORTAL_RATE_WINDOW_MS=300000
PORTAL_RATE_MAX=20
WEBHOOK_RATE_WINDOW_MS=60000
WEBHOOK_RATE_MAX=200

# Recurring note processor (server-side)
RECURRING_NOTES_ENABLED=true
RECURRING_CHECK_INTERVAL_MS=60000
RECURRING_BATCH_SIZE=50
RECURRING_MAX_PASSES=5

# Observability
SERVER_LOG_COLLECTION=serverEvents
SERVER_LOG_TTL_DAYS=30
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=4000

# Firebase Admin SDK (service account JSON)
# Paste the JSON string for your service account key (single-line).
FIREBASE_SERVICE_ACCOUNT_JSON=
